# Configuración del servidor local de Ecodes.
# Copia este archivo como ".env" (sin nada más en el nombre) y llénalo.
# docker compose lo lee solo.

# Contraseña de la base de datos. Cámbiala por una propia.
POSTGRES_PASSWORD=cambia-esta-clave

# Clave para firmar las sesiones. Que sea larga y aleatoria.
# Puedes generar una en https://www.random.org/strings/ o inventarla.
JWT_SECRET_KEY=cambia-esta-clave-por-una-larga-y-aleatoria

# Datos que salen en el certificado laboral.
EMPRESA_NOMBRE=ECODES INGENIERÍA S.A.S.
EMPRESA_NIT=900.000.000-0
EMPRESA_CIUDAD=Bogotá D.C.
FIRMANTE_NOMBRE=Nombre de quien firma
FIRMANTE_CARGO=Directora de Talento Humano
