# Cadena de conexión a PostgreSQL
DATABASE_URL=postgresql+psycopg2://ecodes:ecodes@localhost:5432/ecodes_th

# Autenticación JWT
JWT_SECRET_KEY=cambia-esta-clave-por-una-secreta-y-larga
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS - orígenes permitidos separados por coma
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8080,http://localhost:3000

# Datos de la primera empresa (Ecodes) que se crea al sembrar la base vacía.
# El sistema atiende a más de una empresa a la vez (Ecodes, Envsol...); la
# información de cada una se administra luego desde la propia aplicación
# (Empleados > Empresas), no desde aquí. Estas variables solo importan para
# la primera siembra; si no se configuran, esa primera empresa sale con
# textos entre corchetes bien visibles, para editarlos después sin prisa.
EMPRESA_NOMBRE=ECODES INGENIERÍA S.A.S.
EMPRESA_NIT=900.000.000-0
EMPRESA_CIUDAD=Bogotá D.C.
EMPRESA_DIRECCION=
EMPRESA_TELEFONO=
EMPRESA_CORREO=
FIRMANTE_NOMBRE=Nombre de quien firma
FIRMANTE_CARGO=Directora de Talento Humano
