# Copiar a .env y NUNCA commitear valores reales. Ver docs/00-propuesta-tecnica-funcional.md.
#
# IMPORTANTE: ASP.NET Core lee variables de entorno con estos nombres EXACTOS
# (sensible a la forma, no a snake_case): las claves anidadas usan doble guion
# bajo ("Seccion__Clave"). Estos mismos nombres funcionan tanto exportados en el
# shell como en un archivo .env cargado por herramientas como docker-compose.

# --- Proveedor de datos (sección 61-64/87) ---
# Mock = en memoria, sin Access ni Google reales (desarrollo/demo).
# Access = Microsoft Access vía OLE DB (requiere host Windows, ver docs/database-access.md).
DataProvider=Mock

# --- Integraciones externas (punto 87) ---
# mock = simula Drive/Gmail/OAuth sin llamar a Google.
# google = login real con Google (Fase 3); Drive/Gmail reales siguen pendientes (Fases 12/13).
IntegrationMode=mock

# --- Microsoft Access (solo si DataProvider=Access, sección 4) ---
# Ruta LOCAL (no de red) al archivo .accdb en el servidor Windows donde corre el backend.
Access__DatabasePath=C:\CuentasPorPagar\Data\CuentasPorPagar.accdb

# --- JWT de sesión de la aplicación (Fase 3, sección 19) ---
# Clave de firma simétrica, mínimo 32 caracteres, generada aleatoriamente por entorno.
# Obligatoria en cualquier ambiente que no sea Development (ver Program.cs).
Jwt__SigningKey=

# --- Google OAuth / Workspace (Fase 3, sección 4/69) ---
# Requerido solo si IntegrationMode=google. Crear las credenciales OAuth en
# Google Cloud Console (tipo "Web application") y, si se restringe por dominio,
# configurar GoogleWorkspaceDomain igual al dominio de Workspace de la empresa.
Google__ClientId=
Google__WorkspaceDomain=

# --- Google Drive (Fase 12, sección 61-71) ---
Google__DriveRootFolderId=

# --- Gmail (Fase 13, sección 17/27-29) — aún no leído por la aplicación ---
EMAIL_FROM=cuentasporpagar@empresa.com

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:5238
# Si se deja vacío, el frontend usa el login simulado (ver frontend/README.md).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
