# Copiar a .env (backend/appsettings.Development.json también puede usarse en su lugar)
# y NUNCA commitear valores reales. Ver docs/00-propuesta-tecnica-funcional.md.

# --- Proveedor de datos (sección 61-64/87) ---
# Mock = en memoria, sin Access ni Google reales (desarrollo/demo).
# Access = Microsoft Access vía OLE DB (requiere host Windows, ver docs/database-access.md).
DATA_PROVIDER=Mock

# --- Integraciones externas (punto 87) ---
# mock = simula Drive/Gmail/OAuth sin llamar a Google.
# google = integraciones reales (requiere credenciales de Google Workspace, Fases 3/12/13).
INTEGRATION_MODE=mock

# --- Microsoft Access (solo si DATA_PROVIDER=Access, sección 4) ---
# Ruta LOCAL (no de red) al archivo .accdb en el servidor Windows donde corre el backend.
ACCESS_DATABASE_PATH=C:\CuentasPorPagar\Data\CuentasPorPagar.accdb

# --- Google OAuth / Workspace (Fase 3, sección 4/69) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_WORKSPACE_DOMAIN=

# --- Google Drive (Fase 12, sección 61-71) ---
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# --- Gmail (Fase 13, sección 17/27-29) ---
EMAIL_FROM=cuentasporpagar@empresa.com

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:5238
